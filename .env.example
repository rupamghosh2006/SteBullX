# Used only by the optional live Stellar SDEX market-data provider.
# Leave unset to keep the UI/API in reproducible DEMO mode.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Set this from a verified issuer source; do not guess an issuer address.
STELLAR_USDC_ISSUER=

# Optional PostgreSQL persistence for simulation results (Neon/Supabase/self-hosted).
# Leave unset to keep results in-memory (ephemeral).
DATABASE_URL=

# Optional Redis for the async job queue + result caching.
# Leave unset to process async jobs in-process (dev/single-node only).
REDIS_URL=

# Optional API-key gate for /api/v1 endpoints. Leave unset for open local use.
STEBULLX_API_KEY=
# Optional hosted API-key gate for /api/v1/stress-tests endpoints.
STEBULLX_API_KEY=
