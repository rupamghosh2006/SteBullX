# Data source mode. Leave unset (or "demo") for the reproducible hand-authored
# fixture. Set to "live" to read a configured Blend index + live Stellar data.
DATA_SOURCE=demo

# Live Blend index (normalized snapshot payload; see docs/LIVE_BLEND_ADAPTER.md).
# Required when DATA_SOURCE=live. Throws instead of silently mixing demo data.
BLEND_API_URL=

# Used only by the optional live Stellar SDEX market-data provider (order book
# and constant-product XLM/USDC pools). Leave unset to keep those DEMO-derived.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Set this from a verified issuer source; do not guess an issuer address.
STELLAR_USDC_ISSUER=

# Optional PostgreSQL persistence for simulation results and replay archives
# (Neon/Supabase/self-hosted). Leave unset to keep results in-memory (ephemeral).
DATABASE_URL=

# Optional Redis for the async job queue + result caching.
# Leave unset to process async jobs in-process (dev/single-node only).
REDIS_URL=

# Optional API-key gate for /api/v1 endpoints. Leave unset for open local use.
STEBULLX_API_KEY=

# Optional archive-store JSON file path (used only without DATABASE_URL/REDIS_URL).
# Defaults to data/archive-store.json (gitignored).
STEBULLX_ARCHIVE_FILE=